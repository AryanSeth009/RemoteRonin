{
  "name": "remote-ronin",
  "version": "0.1.0",
  "description": "Remote developer command center for Windows, built by Aryan Seth",
  "type": "module",
  "bin": {
    "remoteronin": "src/cli/runtime.js"
  },
  "files": [
    "src",
    "config",
    "scripts",
    "setup.ps1",
    "start.cmd",
    "README.md"
  ],
  "scripts": {
    "dev": "node src/cli/runtime.js",
    "build": "node --check src/cli/runtime.js",
    "start": "node src/cli/runtime.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run build && npm test && node src/cli/runtime.js doctor"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "optionalDependencies": {
    "playwright": "^1.65.0"
  }
}
